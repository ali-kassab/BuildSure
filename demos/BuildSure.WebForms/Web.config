<?xml version="1.0" encoding="utf-8"?>
<!-- In .NET Framework, Web.config holds ALL configuration: connection strings, compilation,
     runtime settings, authentication... (ASP.NET Core moved most of this to appsettings.json + Program.cs). -->
<configuration>
  <connectionStrings>
    <add name="BuildSureDb"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=BuildSureDb;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" />
  </system.web>
</configuration>
