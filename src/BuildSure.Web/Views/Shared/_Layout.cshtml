<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BuildSure</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BuildSure.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-dark mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark"></span>BuildSure</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    @{ var controller = ViewContext.RouteData.Values["controller"]?.ToString(); }
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link @(controller == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link @(controller == "Customers" ? "active" : "")" asp-controller="Customers" asp-action="Index">Customers</a></li>
                        <li class="nav-item"><a class="nav-link @(controller == "Applications" ? "active" : "")" asp-controller="Applications" asp-action="Index">Applications</a></li>
                        <li class="nav-item"><a class="nav-link @(controller == "Reports" ? "active" : "")" asp-controller="Reports" asp-action="Index">SQL Reports</a></li>
                    </ul>
                    <span class="badge rounded-pill text-bg-warning">Training simulation</span>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_Alerts" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted small">
        <div class="container">
            BuildSure &middot; Construction insurance management - a training project, not a real insurance system.
        </div>
    </footer>

    <partial name="_ConfirmModal" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
