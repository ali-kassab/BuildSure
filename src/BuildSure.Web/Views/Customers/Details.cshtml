@model Customer
@{
    ViewData["Title"] = Model.FullName;
}

<div class="page-header">
    <div>
        <a asp-action="Index" class="small text-decoration-none">&larr; Customers</a>
        <h1>@Model.FullName</h1>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="js-confirm"
              data-confirm="Delete customer &quot;@Model.FullName&quot;? This cannot be undone.">
            <button type="submit" class="btn btn-outline-danger">Delete</button>
        </form>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card h-100"><div class="card-body">
            <dl class="details mb-0">
                <dt>@Html.DisplayNameFor(m => m.NationalId)</dt><dd>@Model.NationalId</dd>
                <dt>@Html.DisplayNameFor(m => m.PhoneNumber)</dt><dd>@Model.PhoneNumber</dd>
                <dt>@Html.DisplayNameFor(m => m.Email)</dt><dd><a href="mailto:@Model.Email">@Model.Email</a></dd>
                <dt>@Html.DisplayNameFor(m => m.Address)</dt><dd>@Model.Address</dd>
                <dt>@Html.DisplayNameFor(m => m.CreatedAt)</dt><dd class="mb-0">@Model.CreatedAt.ToLocalTime().ToString("g")</dd>
            </dl>
        </div></div>
    </div>

    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <strong>Insurance applications (@Model.Applications.Count)</strong>
                <a asp-controller="Applications" asp-action="Create" asp-route-customerId="@Model.Id" class="btn btn-sm btn-primary">New application</a>
            </div>
            @if (Model.Applications.Count == 0)
            {
                <div class="card-body text-muted">This customer has not submitted any applications.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead><tr><th>Number</th><th>Project</th><th class="text-end">Cost</th><th>Status</th></tr></thead>
                        <tbody>
                            @foreach (var app in Model.Applications)
                            {
                                <tr>
                                    <td><a asp-controller="Applications" asp-action="Details" asp-route-id="@app.Id">@app.ApplicationNumber</a></td>
                                    <td>@app.ProjectName</td>
                                    <td class="text-end">@app.ConstructionCost.ToString("N0")</td>
                                    <td><partial name="_StatusBadge" model="app.Status" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
